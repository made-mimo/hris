# SI HRIS - production environment template.
# Copy to .env, fill in every value marked CHANGE, then run: php artisan hris:install
# Never commit .env or share it: it holds the keys that protect encrypted data.

APP_NAME="SI HRIS"
APP_ENV=production
APP_DEBUG=false
# CHANGE: the public https:// address users type in (no trailing slash). https is mandatory.
APP_URL=https://hris.example.com
# Generated automatically by `php artisan hris:install` if left empty. BACK IT UP afterwards.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# CHANGE: an empty MySQL/MariaDB database (utf8mb4) and a dedicated user for it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CHANGE: outgoing mail (notifications, e-mail 2FA codes, scheduled reports).
# The app sends mail using these values; the SMTP fields on the Settings page are not used for sending.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Browser push notifications. Generated automatically by `hris:install` if left empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@example.com"

# report-only | enforce | off - see config/security.php. Start with report-only.
CSP_MODE=report-only

VITE_APP_NAME="${APP_NAME}"
